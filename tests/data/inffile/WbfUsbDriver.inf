;============================================================================
; Installation file (.inf) for Windows 10 Finger Print USB Device.
;
; All Rights Reserved, Copyright(C) ELAN Microelectronics Corp. 2003-2021
;============================================================================

[Version]
Signature	= "$Windows NT$"
Class		= Biometric
ClassGuid	= {53D29EF7-377C-4D14-864B-EB3A85769359}
Provider	= %ProviderName%
CatalogFile	= WbfUsbDriver.cat
DriverVer	= 03/12/2024, 3.21.12212.20001
PnpLockdown	= 1

[Manufacturer]
%VenderName%		= Elan, NTamd64, NTamd64.10.0...22621

[Elan.NTamd64]
%DeviceName%		= Biometric_Install, 	USB\VID_04F3&PID_0C4B
%DeviceName%		= Biometric_Install, 	USB\VID_04F3&PID_0C57

[Elan.NTamd64.10.0...22621]
%DeviceName%		= Biometric_Install_Win11, 	USB\VID_04F3&PID_0C4B
%DeviceName%		= Biometric_Install_Win11, 	USB\VID_04F3&PID_0C57

;----------------------------------------------------------------------------
; SourceDisks Sections
;----------------------------------------------------------------------------

[SourceDisksNames]
1 = %MediaDescription%

[SourceDisksFiles]
WbfUsbDriver.dll		= 1
EngineAdapter.dll		= 1
Enclave_SSL.signed.dll	= 1
Enclave_IOC.signed.dll	= 1
ELANFPService.exe		= 1
;----------------------------------------------------------------------------
; Install Sections
;----------------------------------------------------------------------------

[DestinationDirs]
UMDriverCopy			= 12, UMDF			; \Windows\System32\drivers\UMDF
EFDServiceCopy 			= 11				; Driver directory
WinBioEngineAdapterCopy	= 11, WinBioPlugins	; \Windows\System32\WinBioPlugins
ETDApp.CopyFiles 		= 11				; System directory
;----------------------------------------------------------------------------
; Common File Copy and Registry Operations
;----------------------------------------------------------------------------

[UMDriverCopy]
WbfUsbDriver.dll,,,0x00004000

[WinBioEngineAdapterCopy]
EngineAdapter.dll,,,0x00004000

[EFDServiceCopy]
ELANFPService.exe,,,0x00004000

[ETDApp.CopyFiles]
Enclave_SSL.signed.dll,,,0x00004000
Enclave_IOC.signed.dll,,,0x00004000

;----------------------------------------------------------------------------
; UMDF WBDI Usb Device - WBDI IOCTL interface
;----------------------------------------------------------------------------

;[Device_Properties]
;DeviceIcon,,,,"%%SYSTEMROOT%%\system32\SysClass.dll,-201" ; This is where a device specific icon can be specified.

;----------------------------------------------------------------------------
; Thinkbook-15P
;----------------------------------------------------------------------------

[Biometric_Install.NT]
;AddProperty=Device_Properties
Include=WINUSB.INF                      ; Import sections from WINUSB.INF
Needs=WINUSB.NT                         ; Run the CopyFiles & AddReg directives for WinUsb.INF
CopyFiles=UMDriverCopy,\
		  ETDApp.CopyFiles,\
          WinBioEngineAdapterCopy,\
		  EFDServiceCopy

AddReg=EFD_System.AddReg,\
       EFD_DeviceInfo.AddReg,\
       EFD_OtherSetting.AddReg,\
       EFD_CustomerSetting.AddReg,\
       EFD_StableSolution.AddReg,\
       EFD_CSNoiseSolution.AddReg,\
       EFD_WaterProofSolution.AddReg,\
       EFD_SpecialSettingByPID.AddReg,\
	   EFD_GroupOption_0C4B.AddReg

[Biometric_Install.NT.hw]
AddReg=Biometric_Device_AddReg
AddReg=DriverPlugInAddReg, DatabaseAddReg

[Biometric_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall  		; flag 0x2 sets this as the service for the device
AddService=WinUsb,0x000001f8,WinUsb_ServiceInstall  		; this service is installed because its a filter.
AddService=ELANFPService,0x00000800, ELANFPService_Install

[Biometric_Install.NT.Wdf]
UmdfDispatcher=WinUSB
UmdfService=WbfUsbDriver, WbfUsbDriver_Install
UmdfServiceOrder=WbfUsbDriver
UmdfHostProcessSharing=ProcessSharingDisabled

;----------------------------------------------------------------------------
;Biometric_Install_Win11
;----------------------------------------------------------------------------

[Biometric_Install_Win11.NT]
;AddProperty=Device_Properties
Include=WINUSB.INF, WUDFRD.inf
Needs=WINUSB_LowerFilter.NT, WUDFRD.NT
;Include=WINUSB.INF                      ; Import sections from WINUSB.INF
;Needs=WINUSB.NT                         ; Run the CopyFiles & AddReg directives for WinUsb.INF
CopyFiles=UMDriverCopy,\
		  ETDApp.CopyFiles,\
          WinBioEngineAdapterCopy,\
		  EFDServiceCopy

AddReg=EFD_System.AddReg,\
       EFD_DeviceInfo.AddReg,\
       EFD_OtherSetting.AddReg,\
       EFD_CustomerSetting.AddReg,\
       EFD_StableSolution.AddReg,\
       EFD_CSNoiseSolution.AddReg,\
       EFD_WaterProofSolution.AddReg,\
       EFD_SpecialSettingByPID.AddReg,\
	   EFD_GroupOption_0C4B.AddReg

[Biometric_Install_Win11.NT.hw]
Include=WINUSB.INF, WUDFRD.inf
Needs=WINUSB_LowerFilter.NT.HW, WUDFRD.NT.HW
AddReg=Biometric_Device_AddReg
AddReg=DriverPlugInAddReg, DatabaseAddReg

[Biometric_Install_Win11.NT.Services]
Include=WINUSB.INF, WUDFRD.inf
Needs=WINUSB_LowerFilter.NT.Services, WUDFRD.NT.Services
;AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall  		; flag 0x2 sets this as the service for the device
;AddService=WinUsb,0x000001f8,WinUsb_ServiceInstall  		; this service is installed because its a filter.
AddService=ELANFPService,0x00000800, ELANFPService_Install

[Biometric_Install_Win11.NT.Wdf]
UmdfDispatcher=WinUSB
UmdfService=WbfUsbDriver, WbfUsbDriver_Install
UmdfServiceOrder=WbfUsbDriver
UmdfHostProcessSharing=ProcessSharingDisabled

[Biometric_Install_Win11.NT.Filters]
Include=WINUSB.inf
Needs=WINUSB_LowerFilter.NT.Filters

;----------------------------------------------------------------------------
; end
;----------------------------------------------------------------------------

[WbfUsbDriver_Install]
UmdfLibraryVersion	= 2.19.0
ServiceBinary		= %12%\UMDF\WbfUsbDriver.dll

[ELANFPService_Install]
DisplayName    = "ELAN Service"
ServiceType    = 0x00000010         	; SERVICE_WIN32_OWN_PROCESS
StartType      = 0x00000002         	; SERVICE_AUTO_START
ErrorControl   = 1                  	; SERVICE_ERROR_NORMAL
ServiceBinary  = %11%\ELANFPService.exe

[Biometric_Device_AddReg]
HKR,,"DeviceCharacteristics",0x10001,0x0100     ; Use same security checks on relative opens
HKR,,"Security",,"D:P(A;;GA;;;BA)(A;;GA;;;SY)"  ; Allow generic-all access to Built-in administrators and Local system
HKR,,"LowerFilters",0x00010008,"WinUsb"         ; FLG_ADDREG_TYPE_MULTI_SZ | FLG_ADDREG_APPEND
HKR,,"Exclusive",0x10001,1
HKR,,"SystemWakeEnabled",0x00010001,1
HKR,,"DeviceIdleEnabled",0x00010001,1
HKR,,"UserSetDeviceIdleEnabled",0x00010001,1
HKR,,"DefaultIdleState",0x00010001,1
HKR,,"DefaultIdleTimeout",0x00010001,5000
HKR,,"AllowUserControlSystemWake",0x00010001,0
HKR,,"WinUsbPowerPolicyOwnershipDisabled",0x00010001,1
HKR,"WDF","WdfDirectedPowerTransitionEnable",0x00010001,1

[DriverPlugInAddReg]
HKR,WinBio\Configurations,DefaultConfiguration,,"0"
HKR,WinBio\Configurations\0,SensorMode,0x10001,1                                ; Basic - 1, Advanced - 2
HKR,WinBio\Configurations\0,SystemSensor,0x10001,1                              ; UAC/Winlogon - 1
HKR,WinBio\Configurations\0,SensorAdapterBinary,,"WinBioSensorAdapter.DLL"      ; Windows built-in WBDI sensor adapter.
HKR,WinBio\Configurations\0,EngineAdapterBinary,,"EngineAdapter.DLL"            ; Vendor engine
HKR,WinBio\Configurations\0,StorageAdapterBinary,,"WinBioStorageAdapter.DLL"    ; Windows built-in storage adapter
HKR,WinBio\Configurations\0,DatabaseId,,"D0586DE1-1F56-4F9F-B904-67930F9A703A"  ; Unique database GUID

[DatabaseAddReg]
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},BiometricType,0x00010001,0x00000008
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},Attributes,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},Format,,"00000000-0000-0000-0000-000000000000"
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},InitialSize,0x00010001,0x00000020
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},AutoCreate,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},AutoName,0x00010001,0x00000001
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},FilePath,,""
HKLM,System\CurrentControlSet\Services\WbioSrvc\Databases\{D0586DE1-1F56-4F9F-B904-67930F9A703A},ConnectionString,,""

[WUDFRD_ServiceInstall]
DisplayName		= %WudfRdDisplayName%
ServiceType		= 1
StartType		= 3
ErrorControl	= 1
ServiceBinary	= %12%\WUDFRd.sys
LoadOrderGroup	= Base

[WinUsb_ServiceInstall]
DisplayName     = %WinUsb_SvcDesc%
ServiceType     = 1
StartType       = 3
ErrorControl    = 1
ServiceBinary   = %12%\WinUSB.sys

;----------------------------------------------------------------------------
; Device Information Section
;----------------------------------------------------------------------------

[EFD_DeviceInfo.AddReg]
HKR,"ElanFP\DeviceInfo",DeviceType,%REG_DWORD%,0					; <0> USB, <1> SPI
HKR,"ElanFP\DeviceInfo",AcceptSampleHint,%REG_DWORD%,11			; Max Enroll Times (1~50)
HKR,"ElanFP\DeviceInfo",CoveragePercent,%REG_DWORD%,80			; Coverage Percent (20~100)
HKR,"ElanFP\DeviceInfo",EnrollAreaCenterCount,%REG_DWORD%,0		; <0> Disable, <3 ~ (AcceptSampleHint-1)> Enable (Count Setting)

;----------------------------------------------------------------------------
; Other Setting Section
;----------------------------------------------------------------------------

[EFD_OtherSetting.AddReg]
HKR,"ElanFP\OtherSetting",WaitFingerPressType,%REG_DWORD%,2							; <0> None, <1> By Power State, <2> Force Wait
HKR,"ElanFP\OtherSetting",SupportPowerPlan,%REG_DWORD%,0								; <0> Not Support, <1> Support
HKR,"ElanFP\OtherSetting",SupportPBA,%REG_DWORD%,0									; <0> Not Support, <1> Support
HKR,"ElanFP\OtherSetting",SupportSSO,%REG_DWORD%,1									; <0> Not Support, <1> Support
HKR,"ElanFP\OtherSetting",ForceNoCheckDuplicate,%REG_DWORD%,0						; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",ForceDisableIOC,%REG_DWORD%,0								; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",ForceDisableSGX,%REG_DWORD%,0								; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",SupportRecommendUI,%REG_DWORD%,1							; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",QThreshold_L,%REG_DWORD%,25								; Value experiment by Frank
HKR,"ElanFP\OtherSetting",QThreshold_H,%REG_DWORD%,35								; Value experiment by Frank
HKR,"ElanFP\OtherSetting",PostScanEnable,%REG_DWORD%,0
HKR,"ElanFP\OtherSetting",PollingCalibrationReadyMiniSecond,%REG_DWORD%,10			; Polling calibration ready gap time
HKR,"ElanFP\OtherSetting",PollingCalibrationReadyCount,%REG_DWORD%,50				; Polling calibration ready gap time
HKR,"ElanFP\OtherSetting",EnrollType,%REG_DWORD%,0									; <0> NORMAL_TYPE, <1> SPIRAL_TYPE
HKR,"ElanFP\OtherSetting",ContinuousSpiralEnroll,%REG_DWORD%,1						; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",SupportDoubleLED,%REG_DWORD%,0								; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",SupportLenovoTBG_LED_Spec,%REG_DWORD%,1					; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",ResetFailCountAtSessionChangeWtsSessionLogon,%REG_DWORD%,1	; <0> Disable, <1> Enable
HKR,"ElanFP\OtherSetting",SwipeVerifyEnable,%REG_DWORD%,0							; <0> Disable, <1> Enable

[EFD_GroupOption_0C4B.AddReg]
;0C4B_070 -> Thinkbook 15p
HKR,"ElanFP\GroupOption\PID_0C4B_REV_070",SupportLEDFlashWhenMatch,%REG_DWORD%,0							; <0> Disable, <1> Enable
;0C4B_270 -> Thinkpad E14 E15
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",SupportLEDFlashWhenMatch,%REG_DWORD%,0							; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",SupportEnrollShowDirectionHint,%REG_DWORD%,1					; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",Support_LED_Green_When_Monitor_Off,%REG_DWORD%,0				; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",SupportBlinkLEDGreenWhenFailThreeTimes,%REG_DWORD%,1			; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",SupportKeepWhiteLightWhenTouchFPAfterLogIn3Fail,%REG_DWORD%,1	; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",SupportKeepGreenLightWhenUserEnroll11thFP,%REG_DWORD%,1		; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",SupportRemoteWakeupEnable,%REG_DWORD%,1						; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",WhenDuplicateHappendedShowWhiteLight,%REG_DWORD%,1				; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",SupportS3ShowLEDWhiteForMachineS3,%REG_DWORD%,1				; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_270",ByPassExtraEngineDeactivateAvoidDeletePreCaptureImage,%REG_DWORD%,1				; <0> Disable, <1> Enable
;0C4B_271 -> 14K (Intel/AMD)
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",SupportLEDFlashWhenMatch,%REG_DWORD%,0							; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",SupportEnrollShowDirectionHint,%REG_DWORD%,1					; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",Support_LED_Green_When_Monitor_Off,%REG_DWORD%,1				; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",SupportBlinkLEDGreenWhenFailThreeTimes,%REG_DWORD%,1			; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",SupportKeepWhiteLightWhenTouchFPAfterLogIn3Fail,%REG_DWORD%,1	; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",SupportKeepGreenLightWhenUserEnroll11thFP,%REG_DWORD%,1		; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",SupportRemoteWakeupEnable,%REG_DWORD%,1						; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_271",WhenDuplicateHappendedShowWhiteLight,%REG_DWORD%,1				; <0> Disable, <1> Enable
;0C4B_272 -> E14 (Triones-AMD)
HKR,"ElanFP\GroupOption\PID_0C4B_REV_272",SupportRemoteWakeupEnable,%REG_DWORD%,1
HKR,"ElanFP\GroupOption\PID_0C4B_REV_272",SupportBlinkLEDGreenWhenFailThreeTimes,%REG_DWORD%,1
HKR,"ElanFP\GroupOption\PID_0C4B_REV_272",SupportEnrollShowDirectionHint,%REG_DWORD%,1											; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_272",SupportBlinkLEDGreenWhenFailThreeTimesEvenEnrolledFinger,%REG_DWORD%,1					; <0> Disable, <1> Enable
HKR,"ElanFP\GroupOption\PID_0C4B_REV_272",SupportDoubleLED,%REG_DWORD%,1
HKR,"ElanFP\GroupOption\PID_0C4B_REV_272",DoubleLED_Type,%REG_DWORD%,2
HKR,"ElanFP\GroupOption\PID_0C4B_REV_272",LED_Enter_S4S5_AL0,%REG_DWORD%,2								; <0> None, <1> HIGH, <2> LOW

;----------------------------------------------------------------------------
; Customer Setting Section
;----------------------------------------------------------------------------

[EFD_CustomerSetting.AddReg]
HKR,"ElanFP\CustomerSetting",CustomerDefinition,%REG_DWORD%,4	; <0> NONE, <4> Lenovo
HKR,"ElanFP\CustomerSetting",PlatformType,%REG_DWORD%,2			; <0> Normal NB, <1> 2in1, <2> Standalone
HKR,"ElanFP\CustomerSetting",RegistryDefinition,%REG_DWORD%,1	; <0> HKLM, <1> HKR

;----------------------------------------------------------------------------
; Stable Solution Section
;----------------------------------------------------------------------------

[EFD_StableSolution.AddReg]
HKR,"ElanFP\StableSolution",SupportStableSolution,%REG_DWORD%,0		; <0> No Support, <1> Support
HKR,"ElanFP\StableSolution",StableMeanAvgThreshold,%REG_DWORD%,1000
HKR,"ElanFP\StableSolution",StableDiffAvgThreshold,%REG_DWORD%,600

;----------------------------------------------------------------------------
; CS Noise Solution Section
;----------------------------------------------------------------------------

[EFD_CSNoiseSolution.AddReg]
HKR,"ElanFP\CSNoiseSolution",SupportCSSolution,%REG_DWORD%,0				; <0> No Support, <1> Support
HKR,"ElanFP\CSNoiseSolution",SupportFSRDCSSolution,%REG_DWORD%,1			; <0> No Support, <1> Support
HKR,"ElanFP\CSNoiseSolution",CSNoiseHoldTriggerCount,%REG_DWORD%,4
HKR,"ElanFP\CSNoiseSolution",CSNoiseHoldTime,%REG_DWORD%,30000			; <Unit> ms
HKR,"ElanFP\CSNoiseSolution",CSNoiseDiffAvgThreshold,%REG_DWORD%,1200

;----------------------------------------------------------------------------
; WaterProof Solution Section
;----------------------------------------------------------------------------

[EFD_WaterProofSolution.AddReg]
HKR,"ElanFP\WaterProofSolution",SupportWaterProofSolution,%REG_DWORD%,0			; <0> No Support, <1> Support
HKR,"ElanFP\WaterProofSolution",WaterProof_Level1_Threshold,%REG_DWORD%,40
HKR,"ElanFP\WaterProofSolution",WaterProof_Level1_Count_Threshold,%REG_DWORD%,5
HKR,"ElanFP\WaterProofSolution",WaterProof_Level2_Threshold,%REG_DWORD%,60
HKR,"ElanFP\WaterProofSolution",WaterProof_Level2_Count_Threshold,%REG_DWORD%,3

;----------------------------------------------------------------------------
; SpecialSettingByPID Section
;----------------------------------------------------------------------------

[EFD_SpecialSettingByPID.AddReg]
HKR,"ElanFP\SpecialSettingByPID",TP_VID,%REG_DWORD%,0x04F3
HKR,"ElanFP\SpecialSettingByPID\0x3028",TipsRotateType,%REG_DWORD%,1		; <0> 0 Degree, <1> Rotate Left 90 Degree, <2> Rotate Left 180 Degree, <3> Rotate Left 270 Degree
HKR,"ElanFP\SpecialSettingByPID\0x304D",TipsRotateType,%REG_DWORD%,1		; <0> 0 Degree, <1> Rotate Left 90 Degree, <2> Rotate Left 180 Degree, <3> Rotate Left 270 Degree
HKR,"ElanFP\SpecialSettingByPID\0x3059",TipsRotateType,%REG_DWORD%,1		; <0> 0 Degree, <1> Rotate Left 90 Degree, <2> Rotate Left 180 Degree, <3> Rotate Left 270 Degree
HKR,"ElanFP\SpecialSettingByPID\0x306F",TipsRotateType,%REG_DWORD%,1		; <0> 0 Degree, <1> Rotate Left 90 Degree, <2> Rotate Left 180 Degree, <3> Rotate Left 270 Degree
HKR,"ElanFP\SpecialSettingByPID\0x22FE",TipsRotateType,%REG_DWORD%,1		; <0> 0 Degree, <1> Rotate Left 90 Degree, <2> Rotate Left 180 Degree, <3> Rotate Left 270 Degree


;----------------------------------------------------------------------------
; System Section
;----------------------------------------------------------------------------

[EFD_System.AddReg]
HKLM,%ServiceRoot%"\ElanFP",Version,%REG_SZ%,"%DriverVersion%"
HKLM,%ServiceRoot%"\ElanFP",DriverVersion,%REG_SZ%,"ELAN FingerPrint %DriverVersion%_%DriverBit%_%DriverVersionExtend%"

;----------------------------------------------------------------------------
; RS2 Signature
;----------------------------------------------------------------------------
[SignatureAttributes]
WbfUsbDriver.dll = SignatureAttributes.WindowsHello
EngineAdapter.dll = SignatureAttributes.WindowsHello
Enclave_SSL.signed.dll = SignatureAttributes.WindowsHello
Enclave_IOC.signed.dll = SignatureAttributes.WindowsHello

[SignatureAttributes.WindowsHello]
WindowsHello = true

;----------------------------------------------------------------------------
; String Table
;----------------------------------------------------------------------------

[Strings]
VenderName			= "ELAN"
ProviderName		= "ELAN Finger Print"
Publisher 			= "ELAN Microelectronic Corp."
MediaDescription	= "Elan Driver Installation Media"
ClassName			= "Biometric Devices"
WudfRdDisplayName	= "Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName			= "ELAN WBF Fingerprint Sensor"
WinUsb_SvcDesc		= "WinUSB Driver"
TargetDir			= "ElanFP"
ServiceRoot 		= "System\CurrentControlSet\Control"

; Registry Type
REG_EXPAND_SZ		= 0x00020000
REG_DWORD			= 0x00010001
REG_MULTI_SZ		= 0x00010000
REG_BINARY			= 0x00000001
REG_SZ				= 0x00000000

; ELAN FP Driver Information
DriverDate			= "03/12/2024"
DriverVersion		= "3.21.12212.20001"
DriverBit			= "X64"
DriverVersionExtend	= "WHQL"        ; Trial or Beta or WHQL
