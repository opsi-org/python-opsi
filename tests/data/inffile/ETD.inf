;============================================================================ 
; Installation file (.inf) for Windows 10.
;
; All Rights Reserved, Copyright(C) ELAN Microelectronics Corp. 2003-2020
;============================================================================

[Version]
Signature="$Windows NT$"
Provider=%VenderName%
ClassGUID={4D36E96F-E325-11CE-BFC1-08002BE10318}
Class=Mouse
CatalogFile=ETD.cat
DriverVer=04/06/2020, 32.2.3.5

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
ETD.sys 		= 1

ETDCtrl.exe = 1
ETDCtrlHelper.exe = 1
ETDCmds.dll = 1
ETDApix.dll = 1
ETDFavorite.dll = 1
ETDService.exe = 1
ETDVersion.dll = 1

;----------------------------------------------------------------------------
; Manufacturer Sections
;----------------------------------------------------------------------------

[Manufacturer]
%VenderName%   = ELAN.Mfg, NTamd64, NTamd64.6.2, NTamd64.6.3, NTamd64.10.0

[ELAN.Mfg.NTamd64]

[ELAN.Mfg.NTamd64.6.2]

[ELAN.Mfg.NTamd64.6.3]

[ELAN.Mfg.NTamd64.10.0]
%ELANHIDDeviceDesc% 		= ELAN07XX_Inst_Win10, HID\*ELAN0720&Col05									; MWS
%ELANHIDDeviceDesc% 		= ELAN07XX_Inst_Win10, HID\VEN_ELAN&DEV_0720&Col05					; MWS
%ELANHIDDeviceDesc% 		= ELAN07XX_Inst_Win10, HID\*ELAN0721&Col05									; MWS
%ELANHIDDeviceDesc% 		= ELAN07XX_Inst_Win10, HID\VEN_ELAN&DEV_0721&Col05					; MWS

;----------------------------------------------------------------------------
; Install Sections
;----------------------------------------------------------------------------

[DestinationDirs]
DefaultDestDir 		= 12			; Driver directory
ETDSys.CopyFiles 	= 12			; Driver directory
ETDApp.CopyFiles	= 11			; System32 directory

[ETD_Service_Inst]
DisplayName    = %ELANHIDDeviceDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 0                  ; SERVICE_ERROR_IGNORE
ServiceBinary  = %12%\ETD.sys
LoadOrderGroup = Pointer Port

[ETD_APP_Service_Inst]
DisplayName    = "ELAN Service"
ServiceType    = 0x00000010         ; SERVICE_WIN32_OWN_PROCESS
StartType      = 0x00000002         ; SERVICE_AUTO_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %11%\ETDService.exe
;LoadOrderGroup = ""								; System determines automatically

;----------------------------------------------------------------------------
; Common File Copy and Registry Operations
;----------------------------------------------------------------------------

[ETDSys.CopyFiles]
ETD.sys,,,0x00000001

[ETDApp.CopyFiles]
ETDService.exe,,,0x00000001
ETDCtrl.exe,,,0x00004000
ETDCtrlHelper.exe,,,0x00004000
ETDCmds.dll,,,0x00004000
ETDApix.dll,,,0x00004000
ETDFavorite.dll,,,0x00004000
ETDVersion.dll,,,0x00004000



;----------------------------------------------------------------------------

[ELAN07XX_Inst_Win10]
FeatureScore=F9
Include=msmouse.inf
Needs = HID_Mouse_Inst.NT
CopyFiles=ETDSys.CopyFiles,ETDApp.CopyFiles

AddReg=ETD_System.AddReg,\       
       ETD_Customer_Default.AddReg,\
       ETD_DeviceInfo.AddReg,\
       ETD_UIFunctionOption.AddReg,\
       ETD_DriverOption.AddReg,\
       ETD_OtherSetting_Default.AddReg,\
       ETD07XX_OtherSetting.AddReg,\
       ETD_SmartPadDisplay_Clickpad.AddReg,\
       ETD_SmartPadUI_Default.AddReg,\
       ETD_SmartPadUI_Clickpad.AddReg,\
       ETD_PSTUI.AddReg

CopyINF=ETD_component.inf,ETDHCF.inf,ETDHSA.inf

[ELAN07XX_Inst_Win10.Services]
Include=msmouse.inf
Needs = HID_Mouse_Inst.NT.Services
AddService = ETD,0x00000000, ETD_Service_Inst
AddService = ETDService,0x00000800, ETD_APP_Service_Inst


[ELAN07XX_Inst_Win10.HW]
AddReg = ETD_AddReg.HW

[ELAN07XX_Inst_Win10.Wdf]
KmdfService = ETD, HIDDevice_WdfSect

[ELAN07XX_Inst_Win10.Components]
AddComponent = ETD_component,,ETD_Extension_ComponentInstall_Win10

;----------------------------------------------------------------------------

;----------------------------------------------------------------------------
; End of Hardware ID
;----------------------------------------------------------------------------

;----------------------------------------------------------------------------
; ETD HW
;----------------------------------------------------------------------------
[ETD_AddReg.HW]
HKR,,"UpperFilters",0x00010000,"ETD"

;----------------------------------------------------------------------------
; Wdf Section for PS/2 TouchPad driver
;----------------------------------------------------------------------------

[HIDDevice_WdfSect]
KmdfLibraryVersion = 1.11

[ETD_Extension_ComponentInstall_Win10]
ComponentIds = VID_ETD&SID0006

;----------------------------------------------------------------------------
; System Section
;----------------------------------------------------------------------------

[ETD_System.AddReg]
HKLM,%HKLMRootPath%"\Elantech",Version,%REG_SZ%,"%DriverVersion%"
HKLM,%HKLMRootPath%"\Elantech",DriverVersion,%REG_SZ%,"ELAN %DriverVersion%_%DriverBit%_%DriverVersionExtend%"
HKLM,%HKLMRootPath%"\Elantech",SupportHKRRegistry,%REG_DWORD%,1
;HKR,,ScreenOrientation,%REG_DWORD%,0

