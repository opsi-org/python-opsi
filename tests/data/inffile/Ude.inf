;-------------- Service installation

[UDE_ESIM_Device.NT.Services]
AddService = UDE,%SPSVCINST_ASSOCSERVICE%, UDE_Service_Inst
AddService = %MA.SrvName%, 0x00000800, MAService_Inst

[UDE_NONESIM_Device.NT.Services]
AddService = UDE,%SPSVCINST_ASSOCSERVICE%, UDE_Service_Inst
AddService = %MA.SrvName%, 0x00000800, MAService_Inst

; -------------- UDE driver install sections
[UDE_Service_Inst]
DisplayName    = %UDE.ServiceName%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\UDE.sys
LoadOrderGroup = Extended Base

[MAService_Inst]
DisplayName   = %MA.SrvName%
Description   = %MA.Description%
ServiceType   = 0x00000010
StartType     = 2
ErrorControl  = 1
ServiceBinary = %11%\ModemAuthenticator.exe


[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
SPSVCSINST_STARTSERVICE= 0x00000800
SPSVCINST_CLOBBER_SECURITY= 0x00000400
SPSVCINST_OR_START_CLB_SEC= 3072

eSIMMBIMDisplayName = "DW5823e-eSIM XMM7560 R+ LTE-A"
NoneSIMMBIMDisplayName = "DW5823e XMM7560 R+ LTE-A"
ManufacturerName="Fibocom Wireless Inc."
MA.Description = "Modem Authenticator Service"
MA.SrvName = "ModemAuthenticatorService"
DiskName = "XMM7560-P Installation Disk"
RegTypeDW = 0x00010001
RegTypeStr = 0x00000000
RegTypeQW = 0x0000
SERVICE_ERROR_NORMAL = 0x00000001
SERVICE_AUTO_START = 0x00000002
SERVICE_DEMAND_START = 0x00000003
SERVICE_WIN32_OWN_PROCESS = 0x00000010

UDE.eSIMDeviceDesc = "DW5823e-eSIM Intel(R) XMM7560 R+ LTE-A UDE Device"
UDE.NoeSIMDeviceDesc = "DW5823e Intel(R) XMM7560 R+ LTE-A UDE Device"
UDE.ServiceName = "Intel(R) XMM7560-P"
UDE.BA_RO_REG_KEY = "D:P(D;;KR;;;BA)"				    ;Restrict Built In Admn to read only
UDE.SY_RO_REG_KEY = "D:P(D;;KR;;;SY)"				    ;Restrict Sys Acct to read only
UDE.BASY_RO_REG_KEY = "D:P(D;;KR;;;BA)(D;;KR;;;SY)"	    ;Restrict (Built In Admn and Sys Acct) = RO
UDE.BA_RO_SY_WR_REG_KEY = "D:P(A;;KR;;;BA)(A;;KA;;;SY)"	;Restrict Built In Admn = RO, Allow Sys = All
UDE.BASY_ALL_REG_KEY = "D:P(A;;KA;;;BA)(A;;KA;;;SY)"	;Allow (Built In Admn and Sys) = All
