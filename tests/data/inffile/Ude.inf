Provider=%ManufacturerName%
CatalogFile=UDE.cat
DriverVer = 01/14/2023,0.5.100.871
PnpLockDown=1

[DestinationDirs]
Drivers_Dir = 12
Service_Dir = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
UDE.sys = 1,,
WinIhvRil.dll = 1,,
winihvril_global_configuration.xml = 1,,
ModemAuthenticator.exe =1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%UDE.eSIMDeviceDesc%=UDE_ESIM_Device, PCI\VEN_8086&DEV_7560&SUBSYS_58231028
%UDE.NoeSIMDeviceDesc%=UDE_NONESIM_Device, PCI\VEN_8086&DEV_7560&SUBSYS_3A171028
%UDE.eSIMDeviceDesc%=UDE_ESIM_Device, PCI\VEN_8086&DEV_7560&SUBSYS_00000000


[UDE_ESIM_Device.NT]
CopyFiles=Drivers_Dir,Service_Dir
[UDE_NONESIM_Device.NT]
CopyFiles=Drivers_Dir,Service_Dir

[Drivers_Dir]
UDE.sys

[Service_Dir]
ModemAuthenticator.exe
WinIhvRil.dll
winihvril_global_configuration.xml

[Service_Dir.security]
"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;UD)(A;;GA;;;LS)"


[UDE_ESIM_Device.NT.HW]
Addreg=UDEPHWReg
Include = machine.inf
Needs = PciD3ColdSupported.HW
Addreg=UDEMBIMESIMReg
[UDE_NONESIM_Device.NT.HW]
